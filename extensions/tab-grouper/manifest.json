{
  "manifest_version": 3,
  "name": "AgenticPW Tab Grouper",
  "description": "Companion extension for agentic-playwright-mcp. Provides chrome.tabGroups API access via CDP.",
  "version": "1.2.0",
  "key": "",
  "permissions": ["tabs", "tabGroups", "alarms", "storage", "debugger"],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "ids": ["*"]
  }
}
